# ./scripts/setup-local.sh creates an ignored .env with random local credentials.
# These names document configuration; no values here are usable credentials.
POSTGRES_PASSWORD=
RECOLLECT_DB_PASSWORD=
DATABASE_ADMIN_URL=
DATABASE_URL=
RECOLLECT_OWNER_USERNAME=owner
RECOLLECT_OWNER_PASSWORD=
RECOLLECT_BIND=127.0.0.1:8787
RECOLLECT_PUBLIC_ORIGIN=http://127.0.0.1:8787
RECOLLECT_STATIC_DIR=web/dist
NEO4J_URL=http://127.0.0.1:57474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
RECOLLECT_CREDENTIAL_FILE=.data/runtime/credentials.json
# setup-local.sh records your numeric UID/GID for writable container bind mounts.
# RECOLLECT_LOCAL_UID=
# RECOLLECT_LOCAL_GID=
RECOLLECT_ARTIFACT_DIR=.data/artifacts
# Optional OIDC: set all three in the ignored .env, or leave them absent.
# RECOLLECT_OIDC_ISSUER=
# RECOLLECT_OIDC_CLIENT_ID=
# RECOLLECT_OIDC_CLIENT_SECRET=
# RECOLLECT_OIDC_SCOPES=profile groups
# Optional provider credential. Brain policy separately permits model transmission.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# RECOLLECT_TEXT_MODEL=
RECOLLECT_EMBEDDING_MODEL=text-embedding-3-large
RECOLLECT_EMBEDDING_DIMENSIONS=3072
# Optional per-model request overrides: a JSON array that REPLACES the built-in table.
# Entries: {"provider","model","reasoning"?,"routing"?}; "routing" keys merge into
# OpenRouter's provider preferences (only, sort, max_price, ...) on top of
# {"require_parameters":true,"allow_fallbacks":false}. The built-in table holds
# z-ai/glm-5.3-flash, z-ai/glm-4.7-flash, openai/gpt-6-luna (openrouter) and
# gpt-5.6-luna (openai); an invalid value is logged and the built-ins are used.
# RECOLLECT_MODEL_ROUTES=[{"provider":"openrouter","model":"vendor/model","reasoning":{"effort":"low"},"routing":{"sort":"throughput"}}]
# Optional PostgreSQL pool size (4-500, default 32); keep it below the server max_connections.
# RECOLLECT_DB_POOL_SIZE=32
# Optional companion extraction overrides; defaults stay in Recollect's ignored directories.
# RECOLLECT_ENOLA_BIN=
# RECOLLECT_PUBLICATION_DIR=
# Durable deletion journal; keep separately from rotating database/artifact backups.
RECOLLECT_ERASURE_JOURNAL=.data/erasure-journal
