          "label": "Original five-step approved connector wizard"
        }
      ],
      "vision": [
        {
          "asset": "output/imagegen/2026-10-05-management-concepts-01a10b36/02-add-connection.png",
          "label": "Approved generated concept"
        }
      ],
      "after": [
        {
          "label": "Paste config \u00b7 parsed example; secret unset",
          "images": {
