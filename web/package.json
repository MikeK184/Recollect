{
  "name": "recollect-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../.cache/openapi.json -o src/api-schema.d.ts",
    "check:design": "node scripts/check-design.mjs",
    "typecheck": "npm run check:design && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:ui": "playwright test",
    "format": "prettier --write src/App.tsx src/api.ts src/main.tsx src/styles.css vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.0",
    "cytoscape": "3.34.3",
    "lucide-react": "^1.45.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "Apache-2.0"
}
