{
  "name": "recollect-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../.cache/openapi.json -o src/api-schema.d.ts",
    "check:design": "node scripts/check-design.mjs",
    "typecheck": "npm run check:design && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:ui": "playwright test",
    "format": "prettier --write src/App.tsx src/api.ts src/main.tsx src/styles.css vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "3.34.3",
    "lowlight": "3.3.0",
    "lucide-react": "^1.45.0",
    "motion": "^14.0.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-3d": "^1.29.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "Apache-2.0",
  "overrides": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dismissable-layer": "1.1.20",
    "@radix-ui/react-focus-scope": "1.2.0",
    "@radix-ui/react-focus-guards": "1.1.6",
    "@radix-ui/react-portal": "1.1.18",
    "@radix-ui/react-presence": "1.1.11",
    "@radix-ui/react-primitive": "2.1.11",
    "@radix-ui/react-compose-refs": "1.1.5",
    "three-render-objects": {
      "@tweenjs/tween.js": "25.0.0"
    }
  }
}
